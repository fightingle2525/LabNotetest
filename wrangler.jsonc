{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workers-ai-test",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-12",
  
  "observability": {
    "enabled": true
  },

  "ai": {
    "binding": "AI"
  },

  "queues": {
    "producers": [
      {
        "binding": "MINUTES_QUEUE",
        "queue": "minutes-queue"
      }
    ],
    "consumers": [
      {
        "queue": "minutes-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 10,
        "max_concurrency": 1
      }
    ]
  }
}